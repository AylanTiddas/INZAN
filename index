        });
    };

    const callGeminiAPI = async (payload, expectJson=false) => {
        const key = await getGeminiKey();
        if (!key) throw new Error('Clé API non fournie.');
        const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${encodeURIComponent(key)}`;
        if (expectJson) payload.generationConfig = { responseMimeType: "application/json" };
        const MAX = 4; let delay = 1000;
        for (let attempt=0; attempt<MAX; attempt++) {
            try {
                const res = await fetch(API_URL, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
                if (!res.ok) {
                    if ([429,500,503].includes(res.status) && attempt < MAX-1) { await new Promise(r => setTimeout(r, delay)); delay *= 2; continue; }
                    const err = await res.json().catch(()=>({error:{message:`HTTP ${res.status}`}}));
                    throw new Error(err?.error?.message || `Erreur HTTP ${res.status}`);
                }
                const json = await res.json();
                const text = json?.candidates?.[0]?.content?.parts?.[0]?.text;
                if (!text) throw new Error('Réponse API vide ou malformée.');
                if (expectJson) {
                    try { return JSON.parse(text); } catch(e) { throw new Error('JSON malformé retourné par l’API.'); }
                }
                return text;
            } catch (err) {
                if (attempt < MAX-1) { await new Promise(r => setTimeout(r, delay)); delay *= 2; continue; }
                throw err;
            }
        }
    };

