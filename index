            dom.ai.stepFeedback.textContent = `Mots-clés: ${keywords.join(', ')}`;
            const local = filterProverbs(keywords);
            if (local.length === 0) {
                dom.ai.resultFeedback.innerHTML = `<p class="text-center text-[var(--color-text-light)]">Aucun proverbe trouvé localement.</p>`;
                return;
            }
            const candidates = local.slice(0,30).map(p => ({ id: p.id, kabyle: p.kabyle, francais: p.francais, theme: p.theme }));
            const suggestion = await getAISuggestion_Stage2_GetFinalSelection(context, candidates);
            if (!suggestion || !Array.isArray(suggestion.proverbs) || suggestion.proverbs.length === 0) {
                dom.ai.resultFeedback.innerHTML = `<p class="text-center text-[var(--color-text-light)]">Le sage n'a pas trouvé de correspondance parfaite.</p>`;
                return;
            }
            let html = `<p class="italic text-[var(--color-text-light)]">"${suggestion.reasoning}"</p>`;
            suggestion.proverbs.forEach(p => {
                const full = state.proverbs.find(x => x.id === p.id);
                if (full) {
                    html += `<div class="p-3 mb-3 bg-[var(--color-bg)] rounded-lg border-l-4 border-[var(--color-secondary)]"><p class="font-semibold">Justification :</p><p class="italic">${p.justification}</p></div>`;
                    html += createProverbCardHTML(full, false, keywords.join(' '));
                }
            });
            dom.ai.resultFeedback.innerHTML = html;
        } catch (e) {
            dom.ai.resultFeedback.innerHTML = `<p class="text-red-500 text-center">Erreur: ${e.message}</p>`;
        } finally {
            dom.ai.suggestBtn.disabled = false;
            dom.ai.suggestBtn.textContent = '✨ Demander conseil';
            dom.ai.stepFeedback.textContent = '';
        }
    };

    /* --------------------------
       Quiz IA (pré-chargement et UI)
       -------------------------- */
    const preloadQuizQuestions = async () => {
        if (state.aiQuiz.preloadPromise) return state.aiQuiz.preloadPromise;
        state.aiQuiz.isLoading = true;
        state.aiQuiz.preloadPromise = (async () => {
            try {
                const shuffled = [...state.proverbs].sort(() => 0.5 - Math.random());
                const sample = shuffled.slice(0, 30).map(p => ({ kabyle: p.kabyle, francais: p.francais, theme: p.theme }));
                const promptSystem = `Génère 10 questions au format JSON {"questions":[{question,options,correctAnswerIndex,explanation}] } basées uniquement sur la liste fournie.`;
                const userPrompt = JSON.stringify(sample);
                const json = await callGeminiAPI({
                    contents: [{ parts: [{ text: userPrompt }] }],
                    systemInstruction: { parts: [{ text: promptSystem }] }
                }, true);
                if (!json || !Array.isArray(json.questions)) throw new Error('JSON invalide pour le quiz');
                state.aiQuiz.questions = json.questions.map(q => ({
                    question: q.question,
                    options: q.options,
                    correctAnswerIndex: q.correctAnswerIndex,
                    explanation: q.explanation
                }));
            } catch (e) {
                state.aiQuiz.questions = [];
                state.aiQuiz.preloadPromise = null;
                throw e;
            } finally {
                state.aiQuiz.isLoading = false;
            }
        })();
        return state.aiQuiz.preloadPromise;
    };

    const showQuizStartScreen = () => {
        dom.quizContainer.innerHTML = `
            <div id="quiz-start-screen" class="text-center">
                <p class="text-lg text-[var(--color-text-light)] mb-6">Prêt à tester vos connaissances ?</p>
                <button id="start-ai-quiz-btn" class="w-full px-6 py-3 bg-[var(--color-primary)] text-white font-bold rounded-lg">Lancer le Quiz IA (10 questions)</button>
            </div>
            <div id="quiz-game-screen" class="hidden"></div>
        `;
        document.getElementById('start-ai-quiz-btn').addEventListener('click', handleStartAiQuiz);
    };

    const handleStartAiQuiz = async () => {
        if (state.aiQuiz.questions.length > 0 && !state.aiQuiz.isLoading) {
            startQuizUI(); return;
        }
        dom.quizContainer.innerHTML = `<div class="text-center p-8"><span class="loader"></span><p class="mt-4 text-[var(--color-text-light)]">Le Sage Artificiel prépare vos questions...</p></div>`;
        try {
            await preloadQuizQuestions();
            startQuizUI();
        } catch (e) {
            dom.quizContainer.innerHTML = `<div class="text-center text-red-500"><p>Erreur: ${e.message}</p><button id="retry-ai-quiz-btn" class="mt-4 px-5 py-2 bg-[var(--color-primary)] text-white rounded">Réessayer</button></div>`;
            document.getElementById('retry-ai-quiz-btn').addEventListener('click', showQuizStartScreen);
        }
    };

    const startQuizUI = () => {
        state.aiQuiz.currentQuestionIndex = 0; state.aiQuiz.score = 0;
        if (!dom.quizContainer.querySelector('#quiz-game-screen')) dom.quizContainer.innerHTML = `<div id="quiz-game-screen"></div>`;
        displayAiQuizQuestion();
    };

    const displayAiQuizQuestion = () => {
        const screen = dom.quizContainer.querySelector('#quiz-game-screen');
        const q = state.aiQuiz.questions[state.aiQuiz.currentQuestionIndex];
        if (!q) { showAiQuizResults(); return; }
        const optionsHtml = q.options.map((o,i) => `<div class="quiz-option" data-index="${i}" tabindex="0">${o}</div>`).join('');
        screen.classList.remove('hidden');
        screen.innerHTML = `
            <div class="flex justify-between items-center mb-4">
                <span>Question ${state.aiQuiz.currentQuestionIndex+1} / ${state.aiQuiz.questions.length}</span>
                <span>Score: ${state.aiQuiz.score}</span>
            </div>
            <p class="text-xl font-serif text-center mb-6 p-4 bg-[var(--color-bg-alt)] rounded-lg">${q.question}</p>
            <div id="quiz-options" class="space-y-3">${optionsHtml}</div>
            <div id="quiz-feedback-ai" class="mt-6 text-center"></div>
        `;
        const opts = screen.querySelector('#quiz-options');
        const handleSelection = (target) => {
            const btn = target.closest('.quiz-option');
            if (!btn || btn.hasAttribute('disabled')) return;
            handleAiQuizAnswer(parseInt(btn.dataset.index,10));
        };
        opts.addEventListener('click', (e) => handleSelection(e.target));
        opts.addEventListener('keydown', (e) => { if (['Enter',' '].includes(e.key)) { e.preventDefault(); handleSelection(e.target); } });
    };

    const handleAiQuizAnswer = (selectedIndex) => {
        const q = state.aiQuiz.questions[state.aiQuiz.currentQuestionIndex];
        const correct = selectedIndex === q.correctAnswerIndex;
        if (correct) state.aiQuiz.score++;
        document.querySelectorAll('.quiz-option').forEach((el, idx) => {
            el.setAttribute('disabled', true);
            if (idx === q.correctAnswerIndex) el.classList.add('correct');
            else if (idx === selectedIndex) el.classList.add('incorrect');
        });
        const feedback = dom.quizContainer.querySelector('#quiz-feedback-ai');
        feedback.innerHTML = `<div class="p-4 rounded-lg ${correct?'bg-green-50':'bg-red-50'}"><p class="${correct?'text-green-600':'text-red-600'} font-bold">${correct?'Bravo !':'Dommage !'}</p><p class="mt-2">${q.explanation}</p></div><button id="next-ai-quiz-btn" class="mt-4 w-full px-6 py-2 bg-[var(--color-primary)] text-white rounded">${state.aiQuiz.currentQuestionIndex === state.aiQuiz.questions.length-1 ? 'Voir les résultats' : 'Question suivante'}</button>`;
        document.getElementById('next-ai-quiz-btn').addEventListener('click', handleAiQuizNext);
        document.getElementById('next-ai-quiz-btn').focus();
    };

    const handleAiQuizNext = () => {
        state.aiQuiz.currentQuestionIndex++;
        if (state.aiQuiz.currentQuestionIndex < state.aiQuiz.questions.length) displayAiQuizQuestion();
        else showAiQuizResults();
    };

    const showAiQuizResults = () => {
        const screen = dom.quizContainer.querySelector('#quiz-game-screen');
        if (!screen) return;
        state.aiQuiz.questions = [];
        state.aiQuiz.preloadPromise = null;
        screen.innerHTML = `<div class="text-center"><h3 class="text-2xl font-bold mb-4">Quiz Terminé !</h3><p class="text-4xl text-[var(--color-primary)] mb-2">${state.aiQuiz.score} / ${10}</p><p class="mb-8">Merci d'avoir joué.</p><button id="restart-ai-quiz-btn" class="w-full px-6 py-3 bg-[var(--color-primary)] text-white rounded">Recommencer</button></div>`;
        document.getElementById('restart-ai-quiz-btn').addEventListener('click', showQuizStartScreen);
        // pré-charger le prochain quiz en arrière-plan
        setTimeout(preloadQuizQuestions, 1500);
    };

    /* --------------------------
       Événements UI globaux
       -------------------------- */
    const setupInfiniteScroll = () => {
        const obs = new IntersectionObserver(entries => { if (entries[0].isIntersecting) loadNextChunk(false); }, { threshold: 0.1 });
        obs.observe(dom.loaderContainer);
    };

    const setupEventListeners = () => {
        dom.searchInput.addEventListener('input', debounce(() => {
            dom.clearSearchBtn.classList.toggle('visible', !!dom.searchInput.value);
            loadNextChunk(true);
        }, 350));
        dom.clearSearchBtn.addEventListener('click', () => { dom.searchInput.value=''; dom.clearSearchBtn.classList.remove('visible'); loadNextChunk(true); dom.searchInput.focus(); });

        dom.goToExplorerBtn.addEventListener('click', () => setActiveTab('explorer-tab'));
        dom.randomBtn.addEventListener('click', () => {
            if (!state.isCoreDataLoaded) return showToast("Veuillez attendre le chargement des proverbes.", true);
            const matching = filterProverbs();
            dom.resultsContainer.innerHTML = '';
            if (matching.length === 0) { dom.noResults.classList.remove('hidden'); dom.resultsFeedback.textContent = 'Aucun proverbe'; return; }
            const sample = matching.sort(() => 0.5 - Math.random()).slice(0, Math.min(20, matching.length));
            renderChunk(dom.resultsContainer, sample, dom.searchInput.value, false);
            state.displayedProverbs = sample; state.totalFilteredCount = sample.length; state.currentPage = 1;
            updateAvailableThemes(sample);
            dom.resultsFeedback.textContent = `Affichage d'une sélection aléatoire de ${sample.length} sur ${matching.length} proverbes correspondants.`;
        });

        window.addEventListener('scroll', () => dom.backToTopBtn.classList.toggle('visible', window.scrollY > 300));
        dom.backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

        // navigation tabs
        document.querySelectorAll('[data-tab]').forEach(btn => btn.addEventListener('click', () => setActiveTab(btn.dataset.tab)));

        // theme pills
        dom.themeListContainer.addEventListener('click', (e) => {
            const t = e.target.closest('.theme-pill-button');
            if (!t) return;
            dom.themeListContainer.querySelector('.active')?.classList.remove('active');
            t.classList.add('active');
            state.activeTheme = t.dataset.theme;
            localStorage.setItem('inzan_theme_filter', state.activeTheme);
            loadNextChunk(true);
        });

        // clicks inside results (delegation)
        document.body.addEventListener('click', (e) => {
            const card = e.target.closest('[data-id]');
            if (!card) return;
            const id = parseInt(card.dataset.id,10);
            const prov = state.proverbs.find(p => p.id === id);
            if (!prov) return;
            if (e.target.closest('.explain-btn')) getProverbExplanation(prov);
            else if (e.target.closest('.favorite-btn')) toggleFavorite(id);
            else if (e.target.closest('.copy-btn')) {
                navigator.clipboard.writeText(`« ${prov.kabyle} »\n— ${prov.francais}`).then(()=>showToast('✅ Proverbe copié !')).catch(()=>showToast('Échec du copier', true));
            } else if (e.target.closest('.share-btn')) {
                if (navigator.share) {
                    navigator.share({ title: 'Proverbe Kabyle', text: `« ${prov.kabyle} » — ${prov.francais}`, url: location.href }).catch(()=>{});
                } else {
                    showToast("Le partage n'est pas supporté.", true);
                }
            } else if (e.target.closest('.tts-btn')) speakProverb(`Proverbe kabyle: ${prov.kabyle}. Traduction: ${prov.francais}`);
            else if (e.target.closest('.image-btn')) generateSocialImage(prov);
            else if (e.target.closest('.card-theme-badge')) {
                e.stopPropagation();
                const th = e.target.dataset.theme;
                setActiveTab('explorer-tab');
                setTimeout(()=>{ dom.searchInput.value=''; state.activeTheme = th; localStorage.setItem('inzan_theme_filter', th); loadNextChunk(true); }, 120);
            }
        });

        dom.modal.closeBtn.addEventListener('click', closeModal);
        dom.modal.backdrop.addEventListener('click', closeModal);
        dom.aboutBtn.addEventListener('click', () => openModal('À propos', `<p>Collection numérique dédiée à la sagesse kabyle.</p>`));

        dom.themeToggle.addEventListener('click', () => {
            const isDark = dom.html.classList.toggle('dark');
            dom.themeToggle.setAttribute('aria-pressed', String(isDark));
            localStorage.setItem('inzan_theme', isDark ? 'dark' : 'light');
            dom.themeIcons.light.classList.toggle('hidden', isDark);
            dom.themeIcons.dark.classList.toggle('hidden', !isDark);
            document.querySelector('meta[name="theme-color"]').setAttribute('content', isDark ? '#101418' : '#F9F7F3');
        });

        dom.ai.suggestBtn.addEventListener('click', () => {
            const context = dom.ai.contextInput.value.trim();
            if (!context) return showToast('Veuillez décrire une situation.', true);
            getAISuggestion(context);
        });

        dom.setApiKeyBtn.addEventListener('click', async () => {
            // Force the API modal
            const key = await getGeminiKey();
            showToast(key ? 'Clé enregistrée en session.' : 'Aucune clé fournie', key ? false : true);
        });
    };

    /* --------------------------
       Navigation tabs helper
       -------------------------- */
    const setActiveTab = (tabId) => {
        dom.tabContents.forEach(c => c.classList.toggle('active', c.id === tabId));
        document.querySelectorAll('[data-tab]').forEach(b => b.classList.toggle('active', b.dataset.tab === tabId));
        if (tabId === 'favoris-tab') renderFavorites();
        if (tabId === 'quiz-tab' && state.isCoreDataLoaded) {
            if (!dom.quizContainer.querySelector('#quiz-start-screen')) showQuizStartScreen();
        }
        if (document.body.clientWidth < 640) window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    /* --------------------------
       Démarrage principal
       -------------------------- */
    const main = () => {
        // theme restore
        const savedTheme = localStorage.getItem('inzan_theme') || 'light';
        dom.html.classList.toggle('dark', savedTheme === 'dark');
        dom.themeIcons.light.classList.toggle('hidden', savedTheme === 'dark');
        dom.themeIcons.dark.classList.toggle('hidden', savedTheme === 'light');
        document.querySelector('meta[name="theme-color"]').setAttribute('content', savedTheme === 'dark' ? '#101418' : '#F9F7F3');

        // register sw
        registerServiceWorker();

        setupEventListeners();
        setupInfiniteScroll();
        setActiveTab('accueil-tab');

        // charge proverbs.json
        fetch('proverbs.json').then(r => {
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            return r.json();
        }).then(data => {
            if (!Array.isArray(data)) throw new Error('proverbs.json doit être un tableau');
            state.proverbs = data.map((p, idx) => ({
                ...p,
                id: (typeof p.id !== 'undefined') ? p.id : idx,
                kabyle_norm: normalizeText(p.kabyle || ''),
                francais_norm: normalizeText(p.francais || ''),
                theme_norm: normalizeText(p.theme || '')
            }));
            state.isCoreDataLoaded = true;
            dom.proverbCount.textContent = `plus de ${state.proverbs.length} proverbes`;

            // Proverbe du jour
            if (state.proverbs.length) {
                const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);
                const daily = state.proverbs[dayOfYear % state.proverbs.length];
                dom.proverbOfTheDayCard.innerHTML = createProverbCardHTML(daily, true);
            } else {
                dom.proverbOfTheDayCard.innerHTML = `<p class="text-center text-[var(--color-text-light)]">Aucun proverbe disponible.</p>`;
            }

            updateAvailableThemes();
            const savedThemeFilter = localStorage.getItem('inzan_theme_filter');
            if (savedThemeFilter) { state.activeTheme = savedThemeFilter; }

            // Show explorer initial chunk if theme filter is active or search present
            loadNextChunk(true);

            // Preload quiz in background (best-effort)
            setTimeout(() => { preloadQuizQuestions().catch(()=>{}); }, 1000);

            setTimeout(() => dom.splash.classList.add('hidden'), 400);
        }).catch(err => {
            console.error("Erreur chargement proverbs.json:", err);
            dom.resultsContainer.innerHTML = `<div class="md:col-span-2 xl:col-span-3"><div class="text-center p-6 bg-red-50 border border-red-200 rounded"><h2 class="text-red-600">Erreur de chargement</h2><p class="mt-2">Impossible de charger proverbs.json. Vérifiez la présence du fichier et son format JSON.</p><pre class="mt-3 text-xs bg-red-100 p-2 rounded">${err.message}</pre></div></div>`;
            dom.proverbOfTheDayCard.innerHTML = `<p class="text-center text-red-500">Erreur critique des données.</p>`;
            setTimeout(() => dom.splash.classList.add('hidden'), 100);
        });
    };

    // Expose insertChar global for keyboard Tamazight
    window.insertChar = (char) => {
        const input = dom.searchInput;
        const s = input.selectionStart || 0;
        const e = input.selectionEnd || 0;
        input.value = input.value.slice(0,s) + char + input.value.slice(e);
        input.selectionStart = input.selectionEnd = s + char.length;
        input.focus();
        dom.clearSearchBtn.classList.add('visible');
        loadNextChunk(true);
    };

    // Register SW (silent)
    function registerServiceWorker() {
        if ('serviceWorker' in navigator) {
            try { registerServiceWorker(); } catch(e) { console.warn("SW registration failed:", e); }
        }
    }

    // Kick off
    main();
});
</script>
</body>
</html>
