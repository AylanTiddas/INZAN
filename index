    // Normalisation plus sûre : map les caractères tamazight connus et supprime accents
    const normalizeText = (text='') => {
        if (!text) return '';
        let t = text.toLowerCase().trim();
        // remplacements ciblés
        const map = {
            'ɣ':'gh','č':'ch','ǧ':'dj','ɛ':'e','ḥ':'h','ḍ':'d','ṭ':'t','ṣ':'s','ẓ':'z','ṛ':'r','—':' ','–':' '
        };
        t = t.replace(/./g, c => map[c] || c);
        // enlever diacritiques
        t = t.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        // garder lettres, chiffres et espaces
        return t.replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g,' ').trim();
    };

    const renderMarkdown = (text) => {
        const safe = (s) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        if (!text) return '';
        let html = safe(text);
        // titres h3
        html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
        html = html.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>');
        html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');
        // listes simples
        html = html.replace(/^\s*-\s+(.*)$/gim, '<li>$1</li>');
        html = html.replace(/(<li>[\s\S]*?<\/li>)/g, match => `<ul>${match}</ul>`);
        // paragraphs
        return html.split('\n\n').map(p => {
            if (p.trim().startsWith('<h3') || p.trim().startsWith('<ul')) return p;
            return `<p>${p.replace(/\n/g,'<br>')}</p>`;
        }).join('');
    };

