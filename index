    const filterProverbs = (keywords = []) => {
        if (!state.isCoreDataLoaded) return [];
        let normalizedKeywords = [];
        if (keywords.length === 0) {
            const q = dom.searchInput.value || '';
            normalizedKeywords = normalizeText(q).split(' ').filter(Boolean);
        } else {
            normalizedKeywords = keywords.map(k => normalizeText(k)).filter(Boolean);
        }
        return state.proverbs.filter(p => {
            const themeOk = state.activeTheme === 'tous' || (p.theme_norm || '').includes(state.activeTheme);
            if (!themeOk) return false;
            if (normalizedKeywords.length === 0) return true;
            const corpus = `${p.kabyle_norm} ${p.francais_norm} ${p.theme_norm}`;
            return normalizedKeywords.every(k => corpus.includes(k));
        });
    };

