    const getAISuggestion = async (context) => {
        dom.ai.suggestBtn.disabled = true;
        dom.ai.suggestBtn.textContent = 'Analyse...';
        dom.ai.resultFeedback.innerHTML = '';
        try {
            const kres = await getAISuggestion_Stage1_GetKeywords(context);
